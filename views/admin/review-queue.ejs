<%- include('../partials/admin-header', { active: 'review' }) %>
<div class="container content">
  <div class="page-header">
    <h1>Review Queue</h1>
    <span id="totalCount" style="color:var(--text-light)"></span>
  </div>

  <div class="card" style="margin-bottom:1rem">
    <form id="searchForm" style="display:flex;gap:1rem;align-items:end">
      <div class="form-group" style="flex:1;margin:0">
        <input type="text" id="search" placeholder="Search by receipt #, name, or email">
      </div>
      <button type="submit" class="btn btn-primary">Search</button>
    </form>
  </div>

  <div class="card">
    <div id="claimsList"><div class="spinner"></div></div>
  </div>
</div>
<script>
async function loadClaims(search = '') {
  try {
    const url = search ? `/api/review/claims?search=${encodeURIComponent(search)}` : '/api/review/claims';
    const data = await API.get(url);
    document.getElementById('totalCount').textContent = `${data.total} pending`;

    if (!data.claims.length) {
      document.getElementById('claimsList').innerHTML = '<p style="text-align:center;color:var(--text-light);padding:2rem">No pending claims</p>';
      return;
    }
    document.getElementById('claimsList').innerHTML = `
      <table class="table">
        <thead><tr><th>Receipt #</th><th>Customer</th><th>Date</th><th>Amount</th><th>Submitted</th><th>Action</th></tr></thead>
        <tbody>${data.claims.map(c => `
          <tr>
            <td><strong>${c.receiptNumber}</strong></td>
            <td>${c.customerName}<br><small style="color:var(--text-light)">${c.customerEmail}</small></td>
            <td>${formatDate(c.purchaseDate)}</td>
            <td>${formatCurrency(c.submittedAmount)}</td>
            <td>${formatDateTime(c.createdAt)}</td>
            <td><a href="/admin/review/${c.id}" class="btn btn-sm btn-primary">Review</a></td>
          </tr>
        `).join('')}</tbody>
      </table>`;
  } catch (err) {
    showAlert('Failed to load claims', 'danger');
  }
}

document.getElementById('searchForm').addEventListener('submit', (e) => {
  e.preventDefault();
  loadClaims(document.getElementById('search').value);
});

loadClaims();
</script>
<%- include('../partials/footer') %>
