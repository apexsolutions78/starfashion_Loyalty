<%- include('../partials/admin-header', { active: 'review' }) %>
<div class="container content">
  <div class="page-header">
    <h1>Review Queue</h1>
    <span id="totalCount" style="color:var(--text-muted)"></span>
  </div>

  <div class="card" style="margin-bottom:1rem">
    <form id="searchForm" style="display:flex;gap:1rem;align-items:end;flex-wrap:wrap">
      <div class="form-group" style="flex:1;min-width:180px;margin:0">
        <label for="search">Search</label>
        <input type="text" id="search" placeholder="Search by receipt #, name, or email">
      </div>
      <div class="form-group" style="margin:0">
        <label for="status">Status</label>
        <select id="status">
          <option value="PENDING_REVIEW">Pending review</option>
          <option value="REQUEST_CLEARER_IMAGE">Image requested</option>
          <option value="APPROVED">Approved</option>
          <option value="REJECTED">Rejected</option>
          <option value="REVERSED">Reversed</option>
          <option value="SUBMITTED">Submitted</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Filter</button>
    </form>
  </div>

  <div class="card">
    <div id="claimsList"><div class="spinner"></div></div>
  </div>
</div>
<script>
function currentFilters() {
  const params = new URLSearchParams();
  const search = document.getElementById('search').value.trim();
  const status = document.getElementById('status').value;
  if (search) params.set('search', search);
  if (status) params.set('status', status);
  return params.toString();
}

async function loadClaims() {
  const list = document.getElementById('claimsList');
  try {
    const qs = currentFilters();
    const url = qs ? `/api/review/claims?${qs}` : '/api/review/claims';
    const data = await API.get(url);
    const claims = Array.isArray(data?.claims) ? data.claims : [];
    document.getElementById('totalCount').textContent = `${data.total ?? claims.length} claims`;

    if (!claims.length) {
      list.innerHTML = '<p style="text-align:center;color:var(--text-muted);padding:2rem">No claims match this filter</p>';
      return;
    }
    list.innerHTML = `
      <table class="table">
        <thead><tr><th>Receipt #</th><th>Customer</th><th>Date</th><th>Amount</th><th>Status</th><th>Submitted</th><th>Action</th></tr></thead>
        <tbody>${claims.map(c => `
          <tr>
            <td><strong>${esc(c.receiptNumber) || '-'}</strong></td>
            <td>${esc(c.customerName) || '-'}<br><small style="color:var(--text-muted)">${esc(c.customerEmail) || ''}</small></td>
            <td>${formatDate(c.purchaseDate)}</td>
            <td>${formatCurrency(c.submittedAmount)}</td>
            <td>${statusBadge(c.status)}</td>
            <td>${formatDateTime(c.createdAt)}</td>
            <td><a href="/admin/review/${esc(c.id)}" class="btn btn-sm btn-primary">${c.status === 'PENDING_REVIEW' ? 'Review' : 'View'}</a></td>
          </tr>
        `).join('')}</tbody>
      </table>`;
  } catch (err) {
    const msg = err?.error?.message || err?.message || `HTTP ${err?.status || 'error'}`;
    list.innerHTML = `<p style="text-align:center;color:var(--text-muted);padding:2rem">Failed to load claims: ${esc(msg)}</p>`;
    showAlert(msg, 'danger');
  }
}

document.getElementById('searchForm').addEventListener('submit', (e) => {
  e.preventDefault();
  loadClaims();
});

loadClaims();
</script>
<%- include('../partials/footer') %>
