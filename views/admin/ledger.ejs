<%- include('../partials/admin-header', { active: 'ledger' }) %>
<div class="container content">
  <div class="page-header">
    <h1>Points Ledger</h1>
    <span id="totalCount" style="color:var(--text-muted)"></span>
  </div>

  <div id="alert"></div>

  <div class="card" style="margin-bottom:1rem">
    <form id="filterForm" style="display:flex;gap:1rem;align-items:end;flex-wrap:wrap">
      <div class="form-group" style="flex:1;min-width:180px;margin:0">
        <label for="search">Search</label>
        <input type="text" id="search" placeholder="Customer name or email">
      </div>
      <div class="form-group" style="margin:0">
        <label for="type">Type</label>
        <select id="type">
          <option value="">All types</option>
          <option value="PURCHASE_EARN">Purchase Earn</option>
          <option value="REDEMPTION">Redemption</option>
          <option value="CORRECTION_REVERSAL">Correction Reversal</option>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Filter</button>
      <button type="button" class="btn btn-outline" id="resetBtn">Reset</button>
    </form>
  </div>

  <div class="card">
    <div id="ledgerList"><div class="spinner"></div></div>
    <div id="pager" style="display:flex;gap:0.75rem;justify-content:flex-end;align-items:center;margin-top:1rem"></div>
  </div>
</div>
<script>
const emptyMsg = (msg) => `<p style="text-align:center;color:var(--text-muted);padding:1.5rem">${msg}</p>`;

function typeBadge(type) {
  if (type === 'PURCHASE_EARN') return '<span class="badge badge-approved">EARN</span>';
  if (type === 'REDEMPTION') return '<span class="badge badge-pending">REDEEM</span>';
  if (type === 'CORRECTION_REVERSAL') return '<span class="badge badge-rejected">REVERSAL</span>';
  return `<span class="badge badge-used">${String(type || '').replace(/_/g, ' ')}</span>`;
}

function pointsCell(points) {
  const n = Number(points);
  const color = n > 0 ? 'var(--success)' : n < 0 ? 'var(--danger)' : 'var(--text-primary)';
  return `<strong style="color:${color}">${n > 0 ? '+' : ''}${n}</strong>`;
}

let state = { search: '', type: '', offset: 0, limit: 20, total: 0 };

function renderPager() {
  const { total, limit, offset } = state;
  if (!total) { document.getElementById('pager').innerHTML = ''; return; }
  document.getElementById('pager').innerHTML = `
    <small style="color:var(--text-muted)">${offset + 1}-${Math.min(offset + limit, total)} of ${total}</small>
    <button class="btn btn-sm btn-outline" id="prevBtn" ${offset <= 0 ? 'disabled' : ''}>Prev</button>
    <button class="btn btn-sm btn-outline" id="nextBtn" ${offset + limit >= total ? 'disabled' : ''}>Next</button>`;
  document.getElementById('prevBtn')?.addEventListener('click', () => { state.offset = Math.max(0, offset - limit); load(); });
  document.getElementById('nextBtn')?.addEventListener('click', () => { state.offset = offset + limit; load(); });
}

async function load() {
  try {
    document.getElementById('ledgerList').innerHTML = '<div class="spinner"></div>';
    const params = new URLSearchParams({ limit: String(state.limit), offset: String(state.offset) });
    if (state.search) params.set('search', state.search);
    if (state.type) params.set('type', state.type);
    const data = await API.get(`/api/admin/ledger?${params}`);
    state.total = data.total;
    document.getElementById('totalCount').textContent = `${data.total} entries`;
    renderPager();

    if (!data.entries.length) {
      document.getElementById('ledgerList').innerHTML = emptyMsg('No ledger entries found');
      return;
    }

    document.getElementById('ledgerList').innerHTML = `
      <table class="table">
        <thead><tr><th>Date</th><th>Customer</th><th>Type</th><th>Points</th><th>Reason</th></tr></thead>
        <tbody>${data.entries.map(e => `
          <tr>
            <td>${formatDateTime(e.created_at)}</td>
            <td>${esc(e.customerName) || '-'}<br><small style="color:var(--text-muted)">${esc(e.customerEmail) || ''}</small></td>
            <td>${typeBadge(e.type)}</td>
            <td>${pointsCell(e.points)}</td>
            <td><small style="color:var(--text-muted)">${esc(e.reason) || (e.voucher_id ? 'Voucher ' + esc(e.voucher_id) : (e.claim_id ? 'Claim ' + esc(e.claim_id) : '-'))}</small></td>
          </tr>
        `).join('')}</tbody>
      </table>`;
  } catch (err) {
    document.getElementById('ledgerList').innerHTML = emptyMsg('Failed to load ledger');
    showAlert(err.error?.message || 'Failed to load ledger', 'danger');
  }
}

document.getElementById('filterForm').addEventListener('submit', (e) => {
  e.preventDefault();
  state.search = document.getElementById('search').value.trim();
  state.type = document.getElementById('type').value;
  state.offset = 0;
  load();
});

document.getElementById('resetBtn').addEventListener('click', () => {
  document.getElementById('search').value = '';
  document.getElementById('type').value = '';
  state.search = '';
  state.type = '';
  state.offset = 0;
  load();
});

load();
</script>
<%- include('../partials/footer') %>
