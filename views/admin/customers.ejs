<%- include('../partials/admin-header', { active: 'customers' }) %>
<div class="container content">
  <div class="page-header">
    <h1>Customers</h1>
    <span id="totalCount" style="color:var(--text-muted)"></span>
  </div>

  <div id="alert"></div>

  <div class="card" style="margin-bottom:1rem">
    <form id="searchForm" style="display:flex;gap:1rem;align-items:end">
      <div class="form-group" style="flex:1;margin:0">
        <input type="text" id="search" placeholder="Search by name, email, or mobile">
      </div>
      <button type="submit" class="btn btn-primary">Search</button>
      <button type="button" class="btn btn-outline" id="resetBtn">Reset</button>
    </form>
  </div>

  <div class="card">
    <div id="customersList"><div class="spinner"></div></div>
    <div id="pager" style="display:flex;gap:0.75rem;justify-content:flex-end;align-items:center;margin-top:1rem"></div>
  </div>
</div>
<script>
const emptyMsg = (msg) => `<p style="text-align:center;color:var(--text-muted);padding:1.5rem">${msg}</p>`;

let state = { search: '', offset: 0, limit: 20, total: 0 };

function renderPager() {
  const { total, limit, offset } = state;
  if (!total) { document.getElementById('pager').innerHTML = ''; return; }
  const page = Math.floor(offset / limit) + 1;
  const pages = Math.max(1, Math.ceil(total / limit));
  document.getElementById('pager').innerHTML = `
    <small style="color:var(--text-muted)">${offset + 1}-${Math.min(offset + limit, total)} of ${total}</small>
    <button class="btn btn-sm btn-outline" id="prevBtn" ${offset <= 0 ? 'disabled' : ''}>Prev</button>
    <button class="btn btn-sm btn-outline" id="nextBtn" ${offset + limit >= total ? 'disabled' : ''}>Next</button>`;
  document.getElementById('prevBtn')?.addEventListener('click', () => { state.offset = Math.max(0, offset - limit); load(); });
  document.getElementById('nextBtn')?.addEventListener('click', () => { state.offset = offset + limit; load(); });
}

async function load() {
  try {
    document.getElementById('customersList').innerHTML = '<div class="spinner"></div>';
    const params = new URLSearchParams({ limit: String(state.limit), offset: String(state.offset) });
    if (state.search) params.set('search', state.search);
    const data = await API.get(`/api/admin/customers?${params}`);
    state.total = data.total;
    document.getElementById('totalCount').textContent = `${data.total} customers`;
    renderPager();

    if (!data.customers.length) {
      document.getElementById('customersList').innerHTML = emptyMsg('No customers found');
      return;
    }

    document.getElementById('customersList').innerHTML = `
      <table class="table">
        <thead><tr><th>Name</th><th>Contact</th><th>Status</th><th>Points</th><th>Claims</th><th>Joined</th></tr></thead>
        <tbody>${data.customers.map(c => `
          <tr>
            <td><strong>${esc(c.full_name) || '-'}</strong></td>
            <td>${esc(c.email)}<br><small style="color:var(--text-muted)">${esc(c.mobile) || '-'}</small></td>
            <td>${statusBadge(c.status)}</td>
            <td><strong>${Number(c.totalPoints || 0)}</strong></td>
            <td>${Number(c.approvedClaims || 0)}/${Number(c.claimCount || 0)} approved</td>
            <td>${formatDate(c.created_at)}</td>
          </tr>
        `).join('')}</tbody>
      </table>`;
  } catch (err) {
    document.getElementById('customersList').innerHTML = emptyMsg('Failed to load customers');
    showAlert(err.error?.message || 'Failed to load customers', 'danger');
  }
}

document.getElementById('searchForm').addEventListener('submit', (e) => {
  e.preventDefault();
  state.search = document.getElementById('search').value.trim();
  state.offset = 0;
  load();
});

document.getElementById('resetBtn').addEventListener('click', () => {
  document.getElementById('search').value = '';
  state.search = '';
  state.offset = 0;
  load();
});

load();
</script>
<%- include('../partials/footer') %>
