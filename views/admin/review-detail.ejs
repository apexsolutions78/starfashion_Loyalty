<%- include('../partials/admin-header', { active: 'review' }) %>
<div class="container content">
  <div class="page-header">
    <h1>Review Claim</h1>
    <a href="/admin/review" class="btn btn-outline">Back to Queue</a>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card-header">Receipt Image</div>
      <img id="receiptImage" style="width:100%;border-radius:var(--radius-sm)" alt="Receipt">
    </div>
    <div>
      <div class="card">
        <div class="card-header">Submitted Details</div>
        <p style="margin:0.4rem 0"><strong>Receipt #:</strong> <span id="receiptNumber"></span></p>
        <p style="margin:0.4rem 0"><strong>Purchase Date:</strong> <span id="purchaseDate"></span></p>
        <p style="margin:0.4rem 0"><strong>Submitted Amount:</strong> <span id="submittedAmount"></span></p>
        <p style="margin:0.4rem 0"><strong>Articles:</strong> <span id="articles"></span></p>
        <p style="margin:0.4rem 0"><strong>Submitted:</strong> <span id="createdAt"></span></p>
      </div>

      <div class="card">
        <div class="card-header">Customer Info</div>
        <p style="margin:0.4rem 0"><strong>Name:</strong> <span id="customerName"></span></p>
        <p style="margin:0.4rem 0"><strong>Email:</strong> <span id="customerEmail"></span></p>
        <p style="margin:0.4rem 0"><strong>Mobile:</strong> <span id="customerMobile"></span></p>
        <div id="customerHistory" style="margin-top:0.5rem"></div>
      </div>

      <div class="card">
        <div class="card-header">Decision</div>
        <form id="decisionForm">
          <div class="form-row">
            <div class="form-group">
              <label for="approvedAmount">Approved Amount (PKR)</label>
              <input type="number" id="approvedAmount" step="0.01" required>
            </div>
            <div class="form-group">
              <label for="eligibleAmount">Eligible Amount (PKR)</label>
              <input type="number" id="eligibleAmount" step="0.01" required>
            </div>
          </div>
          <div class="form-group">
            <label for="reviewerNotes">Notes</label>
            <textarea id="reviewerNotes" rows="2" placeholder="Optional notes"></textarea>
          </div>
          <div class="form-group" id="rejectReasonGroup" style="display:none">
            <label for="rejectionReason">Rejection Reason *</label>
            <textarea id="rejectionReason" rows="2" placeholder="Required for rejection"></textarea>
          </div>
          <div style="display:flex;gap:1rem">
            <button type="submit" name="action" value="approve" class="btn btn-success" style="flex:1">Approve</button>
            <button type="submit" name="action" value="reject" class="btn btn-danger" style="flex:1">Reject</button>
            <button type="button" onclick="requestImage()" class="btn btn-outline" style="flex:1">Request Clearer Image</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
const claimId = '<%= claimId %>';

async function loadClaim() {
  try {
    const data = await API.get(`/api/review/claims/${claimId}`);
    const c = data.claim;
    document.getElementById('receiptImage').src = `/api/review/claims/${claimId}/image`;
    document.getElementById('receiptNumber').textContent = c.receiptNumber;
    document.getElementById('purchaseDate').textContent = formatDate(c.purchaseDate);
    document.getElementById('submittedAmount').textContent = formatCurrency(c.submittedAmount);
    const articles = Array.isArray(c.submittedArticles)
      ? c.submittedArticles.join(', ')
      : (c.submittedArticles || '-');
    document.getElementById('articles').textContent = articles;
    document.getElementById('createdAt').textContent = formatDateTime(c.createdAt);
    document.getElementById('customerName').textContent = c.customerName;
    document.getElementById('customerEmail').textContent = c.customerEmail;
    document.getElementById('customerMobile').textContent = c.customerMobile;
    document.getElementById('approvedAmount').value = c.submittedAmount;
    document.getElementById('eligibleAmount').value = c.submittedAmount;

    if (data.customerHistory) {
      const h = data.customerHistory;
      document.getElementById('customerHistory').innerHTML = `
        <small style="color:var(--text-muted)">
          Claims: ${Number(h.totalClaims || 0)} total, ${Number(h.approvedClaims || 0)} approved, ${Number(h.rejectedClaims || 0)} rejected, ${Number(h.pendingClaims || 0)} pending
        </small>`;
    }
  } catch (err) {
    showAlert(err.error?.message || 'Failed to load claim', 'danger');
  }
}

document.getElementById('decisionForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const submitter = e.submitter || null;
  if (!submitter || !submitter.value) {
    showAlert('Please click Approve or Reject explicitly', 'info');
    return;
  }
  const action = submitter.value;
  const btn = submitter;
  btn.disabled = true;

  try {
    if (action === 'approve') {
      if (!confirm('Approve this claim and credit points?')) {
        btn.disabled = false;
        return;
      }
      const submitted = Number(document.getElementById('submittedAmount').textContent.replace(/[^0-9.]/g, '')) || 0;
      const approvedAmount = parseFloat(document.getElementById('approvedAmount').value);
      const eligibleAmount = parseFloat(document.getElementById('eligibleAmount').value);
      if (submitted > 0 && (approvedAmount > submitted || eligibleAmount > submitted)) {
        showAlert('Approved/eligible amount cannot exceed submitted amount', 'danger');
        btn.disabled = false;
        return;
      }
      await API.post(`/api/review/claims/${claimId}/approve`, {
        approvedAmount,
        eligibleAmount,
        reviewerNotes: document.getElementById('reviewerNotes').value || undefined,
      });
      showAlert('Claim approved!', 'success');
    } else {
      const reasonField = document.getElementById('rejectionReason');
      const reason = reasonField.value.trim();
      if (!reason) {
        document.getElementById('rejectReasonGroup').style.display = 'block';
        reasonField.focus();
        showAlert('Rejection reason is required', 'danger');
        if (btn) btn.disabled = false;
        return;
      }
      await API.post(`/api/review/claims/${claimId}/reject`, { rejectionReason: reason });
      showAlert('Claim rejected', 'success');
    }
    setTimeout(() => window.location.href = '/admin/review', 1500);
  } catch (err) {
    showAlert(err.error?.message || 'Action failed', 'danger');
    if (btn) btn.disabled = false;
  }
});

async function requestImage() {
  const notes = prompt('Enter notes for the customer:');
  if (!notes) return;
  try {
    await API.post(`/api/review/claims/${claimId}/request-image`, { notes });
    showAlert('Clearer image requested', 'success');
    setTimeout(() => window.location.href = '/admin/review', 1500);
  } catch (err) {
    showAlert(err.error?.message || 'Failed', 'danger');
  }
}

loadClaim();
</script>
<%- include('../partials/footer') %>
