<%- include('../partials/admin-header', { active: 'offers' }) %>
<div class="container content">
  <div class="page-header">
    <h1>Offers</h1>
    <button type="button" class="btn btn-primary" id="showCreateBtn">Create Offer</button>
  </div>

  <div id="alert"></div>

  <div class="card" id="createFormCard" style="display:none;margin-bottom:1.5rem">
    <div class="card-header">Create Offer</div>
    <form id="createOfferForm">
      <div class="form-row">
        <div class="form-group">
          <label for="offerName">Name</label>
          <input type="text" id="offerName" required maxlength="255" placeholder="Double Points Weekend">
        </div>
        <div class="form-group">
          <label for="offerType">Type</label>
          <select id="offerType" required>
            <option value="multiplier">Multiplier</option>
            <option value="fixed_bonus">Fixed Bonus</option>
            <option value="percentage_bonus">Percentage Bonus</option>
            <option value="birthday">Birthday</option>
            <option value="referral">Referral</option>
            <option value="coupon">Coupon</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label for="offerDescription">Description</label>
        <textarea id="offerDescription" rows="2" maxlength="1000" placeholder="Optional description shown to customers"></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="startDate">Start Date</label>
          <input type="date" id="startDate" required>
        </div>
        <div class="form-group">
          <label for="endDate">End Date</label>
          <input type="date" id="endDate" required>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="maxUsesPerCustomer">Max Uses / Customer</label>
          <input type="number" id="maxUsesPerCustomer" min="1" step="1" value="1">
        </div>
        <div class="form-group">
          <label for="globalMaxUses">Global Max Uses</label>
          <input type="number" id="globalMaxUses" min="1" step="1" placeholder="Unlimited if blank">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="priority">Priority</label>
          <input type="number" id="priority" min="0" step="1" value="0">
          <div class="hint">Higher priority offers apply first</div>
        </div>
        <div class="form-group">
          <label for="minPurchase">Min Purchase (PKR)</label>
          <input type="number" id="minPurchase" min="0" step="0.01" placeholder="Optional">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="bonusMultiplier">Multiplier (2 = double points)</label>
          <input type="number" id="bonusMultiplier" min="0" step="0.1" placeholder="e.g. 2">
        </div>
        <div class="form-group">
          <label for="bonusPoints">Fixed Bonus Points</label>
          <input type="number" id="bonusPoints" min="0" step="1" placeholder="e.g. 50">
        </div>
        <div class="form-group">
          <label for="bonusPercentage">Bonus % of Base Points</label>
          <input type="number" id="bonusPercentage" min="0" step="1" placeholder="e.g. 25">
        </div>
      </div>
      <div class="hint" style="margin-bottom:0.75rem">Fill only the bonus field matching the offer type. Leave blank otherwise.</div>
      <div class="form-row">
        <div class="form-group">
          <label for="eligibleArticles">Eligible Article Numbers</label>
          <input type="text" id="eligibleArticles" placeholder="Comma-separated, e.g. SF-3PC-001, SF-3PC-002">
          <div class="hint">Blank = all articles qualify</div>
        </div>
        <div class="form-group">
          <label for="eligibleTiers">Eligible Customer Tiers</label>
          <input type="text" id="eligibleTiers" placeholder="Comma-separated, e.g. gold, platinum">
          <div class="hint">Blank = all tiers qualify</div>
        </div>
      </div>
      <div class="form-group">
        <label for="eligibleCategories">Eligible Categories</label>
        <select id="eligibleCategories" multiple size="4">
          <option value="">Loading categories...</option>
        </select>
        <div class="hint">Hold Ctrl/Cmd to select several. None selected = all categories qualify</div>
      </div>
      <div class="form-group">
        <label for="offerTerms">Terms</label>
        <textarea id="offerTerms" rows="2" maxlength="2000" placeholder="Optional terms and conditions"></textarea>
      </div>
      <div class="form-group">
        <label class="checkbox-group" style="display:flex;gap:0.5rem;align-items:center">
          <input type="checkbox" id="stackable">
          Stackable with other offers
        </label>
      </div>
      <div style="display:flex;gap:0.75rem;justify-content:flex-end">
        <button type="button" class="btn btn-outline" id="cancelCreateBtn">Cancel</button>
        <button type="submit" class="btn btn-primary" id="createSubmitBtn">Create Offer</button>
      </div>
    </form>
  </div>

  <div class="card">
    <div class="card-header">All Offers</div>
    <div id="offersList"><div class="spinner"></div></div>
  </div>

  <div class="card" style="margin-top:1.5rem">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center">
      <span>Article Categories</span>
      <button type="button" class="btn btn-sm btn-primary" id="showCategoryBtn">Add Category</button>
    </div>
    <div id="alertCategory"></div>
    <form id="categoryForm" style="display:none;margin-bottom:1rem">
      <div class="form-row">
        <div class="form-group">
          <label for="categoryName">Category</label>
          <input type="text" id="categoryName" required maxlength="100" placeholder="three-piece">
        </div>
        <div class="form-group">
          <label for="categoryPrefix">Article Prefix</label>
          <input type="text" id="categoryPrefix" required maxlength="100" placeholder="SF-3PC">
        </div>
      </div>
      <div class="form-group">
        <label for="categoryDescription">Description</label>
        <input type="text" id="categoryDescription" maxlength="500" placeholder="Optional">
      </div>
      <input type="hidden" id="categoryId" value="">
      <div style="display:flex;gap:0.75rem;justify-content:flex-end">
        <button type="button" class="btn btn-outline" id="cancelCategoryBtn">Cancel</button>
        <button type="submit" class="btn btn-primary" id="categorySubmitBtn">Save Category</button>
      </div>
    </form>
    <div id="categoriesList"><div class="spinner"></div></div>
  </div>
</div>
<script>
const offersList = document.getElementById('offersList');
const createFormCard = document.getElementById('createFormCard');
const emptyMsg = (msg) => `<p style="text-align:center;color:var(--text-muted);padding:1.5rem">${msg}</p>`;

function activeBadge(isActive) {
  return isActive
    ? '<span class="badge badge-active">ACTIVE</span>'
    : '<span class="badge badge-pending">INACTIVE</span>';
}

function typeBadge(type) {
  return `<span class="badge badge-approved">${String(type || '').replace(/_/g, ' ').toUpperCase()}</span>`;
}

function eligibilitySummary(o) {
  const c = o.conditions || {};
  const bits = [];
  if (Array.isArray(c.eligibleArticles) && c.eligibleArticles.length) bits.push(`articles: ${c.eligibleArticles.join(', ')}`);
  if (Array.isArray(c.eligibleCategories) && c.eligibleCategories.length) bits.push(`categories: ${c.eligibleCategories.join(', ')}`);
  if (Array.isArray(c.eligibleTiers) && c.eligibleTiers.length) bits.push(`tiers: ${c.eligibleTiers.join(', ')}`);
  if (typeof c.minimumPurchaseAmount === 'number' && c.minimumPurchaseAmount > 0) bits.push(`min PKR ${c.minimumPurchaseAmount}`);
  if (c.multiplier) bits.push(`${c.multiplier}x`);
  if (c.bonusPoints) bits.push(`+${c.bonusPoints} pts`);
  if (c.bonusPercentage) bits.push(`+${c.bonusPercentage}%`);
  if (!bits.length) return '';
  return `<br><small style="color:var(--text-muted)">${esc(bits.join(' | '))}</small>`;
}

async function loadOffers() {
  try {
    offersList.innerHTML = '<div class="spinner"></div>';
    const data = await API.get('/api/offers');
    const offers = data.offers || [];
    if (!offers.length) {
      offersList.innerHTML = emptyMsg('No offers yet');
      return;
    }
    offersList.innerHTML = `
      <table class="table">
        <thead><tr><th>Name</th><th>Type</th><th>Status</th><th>Dates</th><th>Usage</th><th>Actions</th></tr></thead>
        <tbody>${offers.map(o => `
          <tr>
            <td><strong>${esc(o.name)}</strong>${o.description ? `<br><small style="color:var(--text-muted)">${esc(o.description)}</small>` : ''}${eligibilitySummary(o)}</td>
            <td>${typeBadge(o.offerType)}</td>
            <td>${activeBadge(!!o.isActive)}</td>
            <td>${formatDate(o.startDate)}<br><small style="color:var(--text-muted)">to ${formatDate(o.endDate)}</small></td>
            <td>
              <small style="color:var(--text-muted)">
                ${o.currentGlobalUses || 0}/${o.globalMaxUses || '∞'} global<br>
                max ${o.maxUsesPerCustomer || 1}/customer
              </small>
            </td>
            <td>
              ${o.isActive
                ? `<button class="btn btn-sm btn-outline" data-action="deactivate" data-id="${esc(o.id)}">Deactivate</button>`
                : `<button class="btn btn-sm btn-success" data-action="activate" data-id="${esc(o.id)}">Activate</button>`}
            </td>
          </tr>
        `).join('')}</tbody>
      </table>`;
  } catch (err) {
    offersList.innerHTML = emptyMsg('Failed to load offers');
    showAlert(err.error?.message || 'Failed to load offers', 'danger');
  }
}

offersList.addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-action]');
  if (!btn) return;
  const { action, id } = btn.dataset;
  btn.disabled = true;
  try {
    await API.post(`/api/offers/${id}/${action}`);
    showAlert(action === 'activate' ? 'Offer activated' : 'Offer deactivated', 'success');
    await loadOffers();
  } catch (err) {
    showAlert(err.error?.message || 'Action failed', 'danger');
    btn.disabled = false;
  }
});

document.getElementById('showCreateBtn').addEventListener('click', () => {
  createFormCard.style.display = 'block';
  if (!document.getElementById('startDate').value) {
    document.getElementById('startDate').value = new Date().toISOString().slice(0, 10);
  }
  document.getElementById('offerName').focus();
});

document.getElementById('cancelCreateBtn').addEventListener('click', () => {
  createFormCard.style.display = 'none';
  document.getElementById('createOfferForm').reset();
});

document.getElementById('createOfferForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('createSubmitBtn');
  btn.disabled = true; btn.textContent = 'Creating...';
  try {
    const payload = {
      name: document.getElementById('offerName').value.trim(),
      offerType: document.getElementById('offerType').value,
      startDate: document.getElementById('startDate').value,
      endDate: document.getElementById('endDate').value,
      maxUsesPerCustomer: Number(document.getElementById('maxUsesPerCustomer').value || 1),
      priority: Number(document.getElementById('priority').value || 0),
      stackable: document.getElementById('stackable').checked,
    };
    const description = document.getElementById('offerDescription').value.trim();
    if (description) payload.description = description;
    const terms = document.getElementById('offerTerms').value.trim();
    if (terms) payload.terms = terms;
    const globalMax = document.getElementById('globalMaxUses').value;
    if (globalMax) payload.globalMaxUses = Number(globalMax);

    const conditions = {};
    const minPurchase = document.getElementById('minPurchase').value;
    if (minPurchase) conditions.minimumPurchaseAmount = Number(minPurchase);

    const multiplier = document.getElementById('bonusMultiplier').value;
    if (multiplier) conditions.multiplier = Number(multiplier);
    const bonusPoints = document.getElementById('bonusPoints').value;
    if (bonusPoints) conditions.bonusPoints = Number(bonusPoints);
    const bonusPercentage = document.getElementById('bonusPercentage').value;
    if (bonusPercentage) conditions.bonusPercentage = Number(bonusPercentage);

    const articles = document.getElementById('eligibleArticles').value
      .split(',').map(s => s.trim()).filter(Boolean);
    if (articles.length) conditions.eligibleArticles = articles;

    const tiers = document.getElementById('eligibleTiers').value
      .split(',').map(s => s.trim()).filter(Boolean);
    if (tiers.length) conditions.eligibleTiers = tiers;

    const categories = Array.from(document.getElementById('eligibleCategories').selectedOptions)
      .map(o => o.value).filter(Boolean);
    if (categories.length) conditions.eligibleCategories = categories;

    if (Object.keys(conditions).length) payload.conditions = conditions;

    await API.post('/api/offers', payload);
    showAlert('Offer created', 'success');
    e.target.reset();
    createFormCard.style.display = 'none';
    await loadOffers();
  } catch (err) {
    showAlert(err.error?.message || 'Failed to create offer', 'danger');
  } finally {
    btn.disabled = false; btn.textContent = 'Create Offer';
  }
});

const categoriesList = document.getElementById('categoriesList');
const categoryForm = document.getElementById('categoryForm');

async function loadCategories() {
  try {
    const data = await API.get('/api/admin/article-categories');
    const rows = data.categories || [];
    const select = document.getElementById('eligibleCategories');

    select.innerHTML = rows.length
      ? rows.map(c => `<option value="${esc(c.category)}">${esc(c.category)} (${esc(c.articlePrefix)})</option>`).join('')
      : '<option value="">No categories defined</option>';

    if (!rows.length) {
      categoriesList.innerHTML = emptyMsg('No article categories defined');
      return;
    }

    categoriesList.innerHTML = `
      <table class="table">
        <thead><tr><th>Category</th><th>Article Prefix</th><th>Description</th><th>Actions</th></tr></thead>
        <tbody>${rows.map(c => `
          <tr>
            <td><strong>${esc(c.category)}</strong></td>
            <td><code>${esc(c.articlePrefix)}</code></td>
            <td>${c.description ? esc(c.description) : '<span style="color:var(--text-muted)">—</span>'}</td>
            <td style="white-space:nowrap">
              <button class="btn btn-sm btn-outline" data-action="edit-category" data-id="${esc(c.id)}"
                data-category="${esc(c.category)}" data-prefix="${esc(c.articlePrefix)}"
                data-description="${esc(c.description || '')}">Edit</button>
              <button class="btn btn-sm btn-outline" data-action="delete-category" data-id="${esc(c.id)}">Delete</button>
            </td>
          </tr>
        `).join('')}</tbody>
      </table>`;
  } catch (err) {
    categoriesList.innerHTML = emptyMsg('Failed to load categories');
  }
}

document.getElementById('showCategoryBtn').addEventListener('click', () => {
  categoryForm.reset();
  document.getElementById('categoryId').value = '';
  document.getElementById('categorySubmitBtn').textContent = 'Save Category';
  categoryForm.style.display = 'block';
  document.getElementById('categoryName').focus();
});

document.getElementById('cancelCategoryBtn').addEventListener('click', () => {
  categoryForm.style.display = 'none';
  categoryForm.reset();
  document.getElementById('categoryId').value = '';
});

categoriesList.addEventListener('click', async (e) => {
  const btn = e.target.closest('button[data-action]');
  if (!btn) return;
  const { action, id } = btn.dataset;

  if (action === 'edit-category') {
    categoryForm.style.display = 'block';
    document.getElementById('categoryId').value = id;
    document.getElementById('categoryName').value = btn.dataset.category;
    document.getElementById('categoryPrefix').value = btn.dataset.prefix;
    document.getElementById('categoryDescription').value = btn.dataset.description;
    document.getElementById('categorySubmitBtn').textContent = 'Update Category';
    return;
  }

  if (action === 'delete-category') {
    if (!confirm('Delete this article category? Existing offers keep their saved conditions.')) return;
    btn.disabled = true;
    try {
      await API.delete(`/api/admin/article-categories/${id}`);
      showAlert('Category deleted', 'success');
      await loadCategories();
    } catch (err) {
      showAlert(err.error?.message || 'Delete failed', 'danger');
      btn.disabled = false;
    }
  }
});

categoryForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('categorySubmitBtn');
  const id = document.getElementById('categoryId').value;
  const payload = {
    category: document.getElementById('categoryName').value.trim(),
    articlePrefix: document.getElementById('categoryPrefix').value.trim(),
  };
  const description = document.getElementById('categoryDescription').value.trim();
  if (description) payload.description = description;

  btn.disabled = true;
  try {
    if (id) {
      await API.patch(`/api/admin/article-categories/${id}`, payload);
      showAlert('Category updated', 'success');
    } else {
      await API.post('/api/admin/article-categories', payload);
      showAlert('Category created', 'success');
    }
    categoryForm.style.display = 'none';
    categoryForm.reset();
    document.getElementById('categoryId').value = '';
    await loadCategories();
  } catch (err) {
    showAlert(err.error?.message || 'Save failed', 'danger');
  } finally {
    btn.disabled = false;
    btn.textContent = 'Save Category';
  }
});

loadCategories();
loadOffers();
</script>
<%- include('../partials/footer') %>
