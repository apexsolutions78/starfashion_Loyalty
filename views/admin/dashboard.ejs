<%- include('../partials/admin-header', { active: 'dashboard' }) %>
<div class="container content">
  <div class="page-header">
    <h1>Admin Dashboard</h1>
  </div>

  <div class="card-stats" id="stats">
    <div class="stat-card"><div class="stat-value" id="pending">-</div><div class="stat-label">Pending Claims</div></div>
    <div class="stat-card"><div class="stat-value" id="approved">-</div><div class="stat-label">Approved Claims</div></div>
    <div class="stat-card"><div class="stat-value" id="rejected">-</div><div class="stat-label">Rejected Claims</div></div>
    <div class="stat-card"><div class="stat-value" id="customers">-</div><div class="stat-label">Total Customers</div></div>
    <div class="stat-card"><div class="stat-value" id="pointsIssued">-</div><div class="stat-label">Points Issued</div></div>
    <div class="stat-card"><div class="stat-value" id="pointsRedeemed">-</div><div class="stat-label">Points Redeemed</div></div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card-header">Pending Claims</div>
      <div id="pendingClaims"><div class="spinner"></div></div>
    </div>
    <div class="card">
      <div class="card-header">Recent Activity</div>
      <div id="recentActivity"><div class="spinner"></div></div>
    </div>
  </div>
</div>
<script>
const emptyMsg = (msg) => `<p style="text-align:center;color:var(--text-muted);padding:1.5rem">${msg}</p>`;

async function loadDashboard() {
  try {
    const [stats, claimsRes, activityRes] = await Promise.all([
      API.get('/api/admin/stats'),
      API.get('/api/review/claims?limit=5'),
      API.get('/api/admin/activity?limit=8'),
    ]);

    document.getElementById('pending').textContent = stats.pendingClaims ?? 0;
    document.getElementById('approved').textContent = stats.approvedClaims ?? 0;
    document.getElementById('rejected').textContent = stats.rejectedClaims ?? 0;
    document.getElementById('customers').textContent = stats.totalCustomers ?? 0;
    document.getElementById('pointsIssued').textContent = stats.totalPointsIssued ?? 0;
    document.getElementById('pointsRedeemed').textContent = stats.totalPointsRedeemed ?? 0;

    const claims = claimsRes.claims || [];
    document.getElementById('pendingClaims').innerHTML = claims.length
      ? claims.map(c => `
        <div style="display:flex;justify-content:space-between;align-items:center;padding:0.75rem 0;border-bottom:1px solid var(--border)">
          <div>
            <strong>${esc(c.receiptNumber)}</strong><br>
            <small style="color:var(--text-muted)">${esc(c.customerName || c.customerEmail)} - ${formatDate(c.purchaseDate)}</small>
          </div>
          <a href="/admin/review/${esc(c.id)}" class="btn btn-sm btn-primary">Review</a>
        </div>
      `).join('')
      : emptyMsg('No pending claims');

    const activity = activityRes.activity || [];
    document.getElementById('recentActivity').innerHTML = activity.length
      ? activity.map(a => `
        <div style="padding:0.65rem 0;border-bottom:1px solid var(--border)">
          <strong>${esc(String(a.action || '').replace(/_/g, ' '))}</strong>
          <small style="display:block;color:var(--text-muted)">${esc(a.actorEmail) || 'system'} · ${formatDateTime(a.created_at)}</small>
        </div>
      `).join('')
      : emptyMsg('No recent activity');
  } catch (err) {
    document.getElementById('pendingClaims').innerHTML = emptyMsg('Failed to load claims');
    document.getElementById('recentActivity').innerHTML = emptyMsg('Failed to load activity');
    showAlert(err.error?.message || 'Failed to load dashboard', 'danger');
  }
}
loadDashboard();
</script>
<%- include('../partials/footer') %>
