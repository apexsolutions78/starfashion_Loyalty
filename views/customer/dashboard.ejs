<%- include('../partials/customer-header', { active: 'dashboard' }) %>
<div class="container content">
  <div class="page-header">
    <h1>My Dashboard</h1>
    <a href="/claims/new" class="btn btn-primary">+ Upload Receipt</a>
  </div>

  <div class="card-stats" id="stats">
    <div class="stat-card"><div class="stat-value" id="balance">-</div><div class="stat-label">Available Points</div></div>
    <div class="stat-card"><div class="stat-value" id="totalClaims">-</div><div class="stat-label">Total Claims</div></div>
    <div class="stat-card"><div class="stat-value" id="pendingClaims">-</div><div class="stat-label">Pending</div></div>
    <div class="stat-card"><div class="stat-value" id="approvedClaims">-</div><div class="stat-label">Approved</div></div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card-header">Recent Claims</div>
      <div id="recentClaims"><div class="spinner"></div></div>
    </div>
    <div class="card">
      <div class="card-header">Notifications</div>
      <div id="notifications"><div class="spinner"></div></div>
    </div>
  </div>
</div>
<script>
async function loadDashboard() {
  try {
    const [balanceRes, claimsRes, notifRes] = await Promise.all([
      API.get('/api/points/balance'),
      API.get('/api/claims?limit=5'),
      API.get('/api/claims/notifications?limit=5'),
    ]);
    document.getElementById('balance').textContent = balanceRes.balance;
    document.getElementById('totalClaims').textContent = claimsRes.total;
    document.getElementById('pendingClaims').textContent = claimsRes.claims.filter(c => c.status === 'PENDING_REVIEW').length;
    document.getElementById('approvedClaims').textContent = claimsRes.claims.filter(c => c.status === 'APPROVED').length;

    const claimsHtml = claimsRes.claims.length ? claimsRes.claims.map(c => `
      <div style="display:flex;justify-content:space-between;align-items:center;padding:0.5rem 0;border-bottom:1px solid var(--border)">
        <div>
          <strong>${esc(c.receiptNumber)}</strong><br>
          <small style="color:var(--text-muted)">${formatDate(c.purchaseDate)} - ${formatCurrency(c.submittedAmount)}</small>
        </div>
        ${statusBadge(c.status)}
      </div>
    `).join('') : '<p style="color:var(--text-muted)">No claims yet</p>';
    document.getElementById('recentClaims').innerHTML = claimsHtml;

    const notifsHtml = notifRes.notifications.length ? notifRes.notifications.map(n => `
      <div style="padding:0.5rem 0;border-bottom:1px solid var(--border)${n.read ? ';opacity:0.65' : ''}" data-notif-id="${esc(n.id)}">
        <strong>${esc(n.title)}</strong><br>
        <small style="color:var(--text-muted)">${esc(n.message)}</small>
        ${n.read ? '' : ` <button type="button" class="btn btn-sm btn-outline" data-action="mark-read" data-id="${esc(n.id)}" style="margin-left:0.5rem">Mark read</button>`}
      </div>
    `).join('') : '<p style="color:var(--text-muted)">No notifications</p>';
    document.getElementById('notifications').innerHTML = notifsHtml;
    if (notifRes.unreadCount > 0) {
      const markAll = document.createElement('div');
      markAll.style.padding = '0.5rem 0';
      markAll.innerHTML = `<button type="button" class="btn btn-sm btn-outline" id="markAllBtn">Mark all read (${notifRes.unreadCount})</button>`;
      document.getElementById('notifications').appendChild(markAll);
      document.getElementById('markAllBtn').addEventListener('click', async () => {
        try {
          await API.post('/api/claims/notifications/read-all');
          loadDashboard();
        } catch (e) {
          showAlert(e.error?.message || 'Failed to mark notifications read', 'danger');
        }
      });
    }
    document.getElementById('notifications').querySelectorAll('button[data-action="mark-read"]').forEach(btn => {
      btn.addEventListener('click', async () => {
        try {
          await API.request(`/api/claims/notifications/${btn.dataset.id}/read`, { method: 'PATCH' });
          loadDashboard();
        } catch (e) {
          showAlert(e.error?.message || 'Failed to mark notification read', 'danger');
        }
      });
    });
  } catch (err) {
    document.getElementById('recentClaims').innerHTML = '<p style="color:var(--text-muted)">Failed to load claims</p>';
    document.getElementById('notifications').innerHTML = '<p style="color:var(--text-muted)">Failed to load notifications</p>';
    showAlert(err.error?.message || 'Failed to load dashboard', 'danger');
  }
}
loadDashboard();
</script>
<%- include('../partials/footer') %>
