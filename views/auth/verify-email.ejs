<div class="auth-container">
  <div class="auth-card">
    <div class="logo">
      <img src="/images/logo.png" alt="Star Fashion">
    </div>
    <h2>Verify Your Email</h2>
    <p class="subtitle">Confirm your email address to secure your account</p>
    <div id="alert"></div>
    <form id="verifyForm">
      <div class="form-group">
        <label for="token">Verification Token</label>
        <input type="text" id="token" name="token" required value="<%= token %>" placeholder="Paste token from your email">
        <p class="hint">Found in the verification email (valid 10 minutes)</p>
      </div>
      <button type="submit" class="btn btn-primary btn-block" <%= token ? '' : 'disabled' %>>Verify Email</button>
    </form>
    <div class="form-group" style="margin-top: 16px">
      <label for="otp">Mobile OTP (optional)</label>
      <div class="form-row">
        <input type="text" id="otp" maxlength="6" placeholder="6-digit code">
        <button type="button" id="verifyOtpBtn" class="btn btn-secondary">Verify Mobile</button>
      </div>
    </div>
    <div class="links">
      <p><a href="/login">Back to sign in</a></p>
    </div>
  </div>
</div>
<script>
const tokenInput = document.getElementById('token');
if (tokenInput.value) {
  tokenInput.closest('.form-group').style.display = 'none';
}

document.getElementById('verifyForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type="submit"]');
  const token = tokenInput.value.trim();
  if (!token) return;
  btn.disabled = true; btn.textContent = 'Verifying...';
  try {
    await API.post('/api/auth/verify-contact', { token, type: 'email' });
    showAlert('Email verified successfully!', 'success');
    setTimeout(() => window.location.href = '/login', 1500);
  } catch (err) {
    showAlert(err.error?.message || 'Verification failed', 'danger');
    btn.disabled = false; btn.textContent = 'Verify Email';
  }
});

document.getElementById('verifyOtpBtn').addEventListener('click', async () => {
  const otp = document.getElementById('otp').value.trim();
  if (!otp) { showAlert('Enter the 6-digit code', 'warning'); return; }
  try {
    await API.post('/api/auth/verify-contact', { token: otp, type: 'mobile' });
    showAlert('Mobile verified successfully!', 'success');
  } catch (err) {
    showAlert(err.error?.message || 'OTP verification failed', 'danger');
  }
});

if (tokenInput.value) {
  document.getElementById('verifyForm').requestSubmit();
}
</script>
