<div class="auth-container">
  <div class="auth-card">
    <div class="logo">
      <img src="/images/logo.png" alt="Star Fashion">
    </div>
    <h2>Reset Password</h2>
    <p class="subtitle">Choose a new password for your account</p>
    <div id="alert"></div>
    <form id="resetForm">
      <div class="form-group">
        <label for="token">Reset Token</label>
        <input type="text" id="token" name="token" required value="<%= token %>" placeholder="Paste token from your email">
        <p class="hint">Found in the reset email (valid 1 hour)</p>
      </div>
      <div class="form-group">
        <label for="newPassword">New Password</label>
        <input type="password" id="newPassword" name="newPassword" required minlength="8" placeholder="Min 8 chars, uppercase, lowercase, number">
        <p class="hint">Must contain uppercase, lowercase, and a number</p>
      </div>
      <div class="form-group">
        <label for="confirmPassword">Confirm Password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8" placeholder="Re-enter new password">
      </div>
      <button type="submit" class="btn btn-primary btn-block">Reset Password</button>
    </form>
    <div class="links">
      <p><a href="/forgot-password">Request a new link</a></p>
      <p><a href="/login">Back to sign in</a></p>
    </div>
  </div>
</div>
<script>
document.getElementById('resetForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = e.target.querySelector('button[type="submit"]');
  const token = document.getElementById('token').value.trim();
  const newPassword = document.getElementById('newPassword').value;
  const confirmPassword = document.getElementById('confirmPassword').value;
  if (newPassword !== confirmPassword) {
    showAlert('Passwords do not match', 'danger');
    return;
  }
  btn.disabled = true; btn.textContent = 'Resetting...';
  try {
    await API.post('/api/auth/reset-password', { token, newPassword });
    showAlert('Password reset successful. Redirecting to sign in...', 'success');
    setTimeout(() => window.location.href = '/login', 1500);
  } catch (err) {
    showAlert(err.error?.message || 'Reset failed', 'danger');
    btn.disabled = false; btn.textContent = 'Reset Password';
  }
});
</script>
