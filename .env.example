# Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=loyalty_user
DATABASE_PASSWORD=change_me_in_production
DATABASE_NAME=starfashion_loyalty

# Session
SESSION_SECRET=change-me-to-a-long-random-secret

# Uploads
UPLOAD_DIR=./private-storage/receipts
MAX_UPLOAD_MB=8

# SMTP
SMTP_HOST=smtp.starfashionofficial.com
SMTP_PORT=587
SMTP_USER=store@starfashionofficial.com
SMTP_PASSWORD=change_me
MAIL_FROM=noreply@starfashionofficial.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Receipt Number Format (configurable regex pattern)
RECEIPT_NUMBER_REGEX=^\d{2}-\d{2}-\d{4}-\d{2}$
